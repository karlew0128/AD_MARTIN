
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Image Transition</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f4f4f4;
            padding-top: 50px;
        }

        #myImage {
            width: 350px;
            height: 250px;
            object-fit: cover;
            border-radius: 15px;
            cursor: pointer;
            transition: opacity 0.5s ease, transform 0.5s ease;
        }

        #myImage:hover {
            transform: scale(1.05);
        }
    </style>
</head>
<body>

    <h2>Click the Picture!</h2>

    <img
        id="myImage"
        src="images/picture1.jpg"
        alt="First picture"
    >

    <script>
        const image = document.getElementById("myImage");

        const firstImage = "images/picture1.jpg";
        const secondImage = "images/picture2.jpg";

        let isFirstImage = true;

        image.addEventListener("click", function() {
            image.style.opacity = 0;

            setTimeout(function() {
                if (isFirstImage) {
                    image.src = secondImage;
                    image.alt = "Second picture";
                } else {
                    image.src = firstImage;
                    image.alt = "First picture";
                }

                isFirstImage = !isFirstImage;
                image.style.opacity = 1;
            }, 300);
        });
    </script>

</body>
</html>
